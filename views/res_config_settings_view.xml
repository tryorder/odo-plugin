<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="res_config_settings_view_form_order_connector" model="ir.ui.view">
        <field name="name">order.connector.config.settings</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">

        <app data-string="Order Connector" string="Order Connector" name="order_connector">
      
            <!-- Insert inside the main sheet -->

                <div class="app_settings_block" data-string="Order Connector Settings" string="Order Connector">
                    <h2>Order Connector</h2>
                    <block>

                        <setting string="Tenant">
                            <field name="connector_tenant" placeholder="dev196" />
                        </setting>

                        <setting string="Test mode">
                            <field name="connector_test_mode"/>
                        </setting>

                    </block>
                </div>

    

            </app>

                    </xpath>
        </field>
    </record>
</odoo>
