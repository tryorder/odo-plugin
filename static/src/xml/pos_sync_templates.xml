<?xml version="1.0" encoding="UTF-8"?>
<template xml:space="preserve">
    <t t-name="pos_sync_page.Template">
        <div class="o_pos_sync_page">
            <h2>POS Sync</h2>
            <button type="button" class="btn btn-primary" t-on-click="syncProducts"  t-att-disabled="state.loading">
             
            <t t-if="state.loading">Syncing...</t>
            <t t-else="">Sync Products</t>

            </button>
        </div>
    </t>
</template>
